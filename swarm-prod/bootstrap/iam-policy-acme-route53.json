{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AcmeTxtSomenteValidacao",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z08950653QMOGGW25O5SQ",
      "Condition": {
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "_acme-challenge.prodcontrol.app.br",
            "_acme-challenge.swarm.prodcontrol.app.br"
          ],
          "route53:ChangeResourceRecordSetsRecordTypes": ["TXT"]
        }
      }
    },
    {
      "Sid": "AcmeLeituraDaZona",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/Z08950653QMOGGW25O5SQ"
    },
    {
      "Sid": "AcmeAcompanharAlteracao",
      "Effect": "Allow",
      "Action": ["route53:GetChange", "route53:ListHostedZonesByName"],
      "Resource": "*"
    }
  ]
}
